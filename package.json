{
  "name": "dsh-lan-chat",
  "version": "1.0.0",
  "description": "局域网聊天助手 — 隔离内网即时通讯：单聊 / 群聊 / 文件传输 / 网段扫描加好友",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "lan",
    "chat",
    "offline",
    "im",
    "intranet",
    "air-gapped",
    "websocket",
    "file-transfer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonchan2026/dsh-lan-chat.git"
  },
  "bugs": {
    "url": "https://github.com/jasonchan2026/dsh-lan-chat/issues"
  },
  "homepage": "https://github.com/jasonchan2026/dsh-lan-chat#readme",
  "author": "JasonChan",
  "scripts": {
    "test": "node scripts/selftest.mjs && node scripts/hosttest.mjs && node scripts/e2etest.mjs && node scripts/sectest.mjs",
    "test:selftest": "node scripts/selftest.mjs",
    "test:host": "node scripts/hosttest.mjs",
    "test:e2e": "node scripts/e2etest.mjs",
    "test:sec": "node scripts/sectest.mjs",
    "test:client": "node scripts/clienttest.mjs"
  }
}
